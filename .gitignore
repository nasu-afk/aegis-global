# ─── Environment / secrets ────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
secrets/
**/secrets.json

# ─── Node / npm ───────────────────────────────────────────────────────────────
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn/
.pnp.*

# ─── Build output (backend services + frontend, all use ./dist) ──────────────
dist/
**/dist/
build/
**/build/
.vite/
*.tsbuildinfo

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
**/logs/

# ─── Test / coverage ──────────────────────────────────────────────────────────
coverage/
**/coverage/
.nyc_output/
tests/e2e/results/
tests/e2e/playwright-report/
playwright-report/
test-results/

# ─── OS / editor cruft ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
.vscode/*
!.vscode/extensions.json
.idea/

# ─── Docker ───────────────────────────────────────────────────────────────────
*.pid
docker-compose.override.yml

# ─── Terraform (infra/terraform) ──────────────────────────────────────────────
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log

# ─── Kubernetes (infra/k8s) ───────────────────────────────────────────────────
