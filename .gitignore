**/k8s/**/*-secret.yaml
kubeconfig
*.kubeconfig

# ─── Python / ML (ml/training) ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
*.ipynb_checkpoints/
ml/training/checkpoints/
ml/training/runs/
*.ckpt
*.pt
*.h5

# ─── Misc local-only artifacts ────────────────────────────────────────────────
*.local
.cache/
security-audit/*.local.*
