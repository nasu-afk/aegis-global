# ─── AEGIS GLOBAL — Environment Variables ────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ─── JWT Auth ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=change_me_in_production_use_256bit_random_string
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── Databases ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=aegis_dev_password
POSTGRES_USER=aegis_admin
POSTGRES_DB=aegis_core

MONGO_PASSWORD=aegis_dev_password
MONGO_USER=aegis_admin

REDIS_PASSWORD=aegis_dev_password

ES_PASSWORD=aegis_dev_password

# ─── AI / ML ──────────────────────────────────────────────────────────────────
# Required: get from https://console.groq.com/keys
GROQ_API_KEY=gsk_...
# Any Groq-hosted model works; llama-3.3-70b-versatile is a strong default.
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Notifications ───────────────────────────────────────────────────────────
# Twilio (SMS + voice) — https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE=+15005550006

# SendGrid (email) — https://app.sendgrid.com
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Firebase Cloud Messaging (push) — https://console.firebase.google.com
FCM_SERVER_KEY=AAAAxxxxxxx...

# ─── Mapping ─────────────────────────────────────────────────────────────────
MAPBOX_TOKEN=pk.eyJ1IjoiYWVnaXMiLCJhIjoiY...

# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000
VITE_MAPBOX_TOKEN=${MAPBOX_TOKEN}
VITE_GROQ_API_KEY=${GROQ_API_KEY}

# ─── Service ports ────────────────────────────────────────────────────────────
GATEWAY_PORT=4000
AUTH_PORT=4001
ALERT_PORT=4002
GIS_PORT=4003
PREDICTION_PORT=4004
SOS_PORT=4005
NOTIFICATION_PORT=4006
RESOURCE_PORT=4007
DRONE_PORT=4008
AI_PORT=4009
HISTORICAL_PORT=4010
SOCIAL_INTEL_PORT=4011

# ─── Kafka ───────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092

# ─── Cloud (production only) ──────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=

GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# ─── Monitoring ──────────────────────────────────────────────────────────────
DATADOG_API_KEY=
DATADOG_APP_KEY=
SENTRY_DSN=

# ─── CI/CD (GitHub Actions secrets) ──────────────────────────────────────────
# KUBE_CONFIG_STAGING=<base64-encoded-kubeconfig>
# KUBE_CONFIG_PRODUCTION=<base64-encoded-kubeconfig>
# SNYK_TOKEN=
# SONAR_TOKEN=
# SONAR_HOST_URL=
# CODECOV_TOKEN=
# SLACK_WEBHOOK_URL=
